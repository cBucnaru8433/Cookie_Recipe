{
    "manifest_version": 3,
    "name": "Cookie Recipe",
    "version": "1.2.4",
    "description": "Export cookies to a JSON file and import them into another browser/profile.",
    "icons": {
        "128": "favicon.png"
    },
    "permissions": [
        "cookies",
        "activeTab",
        "tabs",
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "favicon.png",
            "48": "favicon.png"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "cookie-transfer@constantin.local",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}