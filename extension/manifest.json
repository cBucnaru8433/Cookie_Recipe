{
    "manifest_version": 3,
    "name": "Cookie Transfer",
    "version": "1.1.0",
    "icons": {
        "16": "favicon.png",
        "48": "favicon.png",
        "128": "favicon.png"
    },
    "description": "Export cookies to a JSON file and import them into another browser/profile.",
    "permissions": ["cookies", "activeTab", "tabs", "storage", "downloads"],
    "host_permissions": ["<all_urls>"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "favicon.png",
            "48": "favicon.png",
            "128": "favicon.png"
        }
    }
}